# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (REQUIRED for production)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Demo Mode — Set to "true" ONLY for local development demos.
# MUST be "false" or omitted in production. Never auto-switches to demo mode.
VITE_DEMO_MODE="false"

# ── Razorpay Configuration ──────────────────────────────────────────
# Frontend: only the public Key ID is exposed to the browser
VITE_RAZORPAY_KEY_ID="rzp_live_your_key_id"

# Backend/Server: secret keys — NEVER put these in VITE_ variables
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ── Counter Payment Configuration ──────────────────────────────────
# UPI ID shown as QR code at the ticket counter
COUNTER_UPI_ID="yourbusiness@upi"

# Business display name shown on UPI QR
BUSINESS_NAME="Deuce Adventure Park"

# Currency code (default: INR)
CURRENCY="INR"
